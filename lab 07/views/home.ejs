<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cafe Hub | Home</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('partials/header') %>

    <main>
        <section class="hero">
            <div class="hero-copy">
                <p class="eyebrow">FIND YOUR NEXT FAVOURITE CUP</p>
                <h1>Good coffee.<br><span>Good places.</span></h1>
                <p class="hero-text">Discover welcoming cafes, delicious menus, and cosy corners for your next catch-up, study session, or quiet moment.</p>
                <a class="button primary-button" href="/cafes">Explore Cafes</a>
            </div>
            <div class="hero-art" aria-hidden="true">
                <span class="steam steam-one"></span>
                <span class="steam steam-two"></span>
                <div class="coffee-cup">☕</div>
            </div>
        </section>

        <section class="section-heading">
            <div>
                <p class="eyebrow">EDITOR'S PICKS</p>
                <h2>Featured Cafes</h2>
            </div>
            <a class="text-link" href="/cafes">See all cafes →</a>
        </section>

        <section class="cafe-grid">
            <% cafes.forEach(cafe => { %>
                <article class="cafe-card">
                    <img src="<%= cafe.image %>" alt="Placeholder image for <%= cafe.name %>">
                    <div class="cafe-card-content">
                        <div class="card-topline">
                            <span class="category"><%= cafe.category %></span>
                            <span class="rating">★ <%= cafe.rating %></span>
                        </div>
                        <h3><%= cafe.name %></h3>
                        <p class="location">⌖ <%= cafe.location %></p>
                        <% if (cafe.rating >= 4.5) { %>
                            <p class="highly-rated">Highly Rated</p>
                        <% } %>
                        <a class="button secondary-button" href="/cafe/<%= cafe.id %>">View Details</a>
                    </div>
                </article>
            <% }); %>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
